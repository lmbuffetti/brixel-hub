  "scripts": {
    "start": "NODE_ENV=page-dev webpack serve --config webpack.config.js --progress profile --env DEV --mode development",
    "start-dev": "NODE_ENV=page-dev webpack serve --config webpack.config.js --progress profile --env DEV_LOCAL --mode development",
    "start-prod": "NODE_ENV=page-dev webpack serve --config webpack.config.js --env DEV --mode production",
    "test-build": "babel-node server/webpack.bundle",
    "build": "NODE_ENV=page-dev webpack --config webpack.config.js --progress --env DEV --mode production",
    "build-dev": "NODE_ENV=page-dev webpack --config webpack.config.js --env DEV --mode production",
    "build-stage": "NODE_ENV=page-stage webpack --config webpack.config.js --env STAGING --mode production",
    "build-prod": "NODE_ENV=page-prod webpack --config webpack.config.js --env PROD --mode production",
    "sellerFlowTest": "jest __tests__/OnBoarding/SellerFlow.test.js --updateSnapshot --runInBand --detectOpenHandles",
    "estimationFlowTest": "jest __tests__/OnBoarding/EstimationFlow.test.js --updateSnapshot --runInBand --detectOpenHandles",
    "buyerFlowTest": "jest __tests__/OnBoarding/BuyerFlow.test.js --updateSnapshot --runInBand --detectOpenHandles",
    "allTests": "jest __tests__/Flows --updateSnapshot --runInBand --detectOpenHandles && jest __tests__/RendersPage --updateSnapshot --runInBand --detectOpenHandles",
    "localTests": "NODE_ENV=page-dev jest __tests__/Forms/FactsForm.test.js --runInBand --detectOpenHandles",
    "test": "NODE_ENV=page-dev npm run sellerFlowTest && NODE_ENV=page-dev npm run estimationFlowTest && NODE_ENV=page-dev npm run buyerFlowTest && NODE_ENV=page-dev npm run allTests",
    "test-stage": "NODE_ENV=page-stag npm run sellerFlowTest && NODE_ENV=page-stag npm run estimationFlowTest && NODE_ENV=page-stag npm run buyerFlowTest && NODE_ENV=page-stag npm run allTests",
    "test-prod": "NODE_ENV=page-prod npm run sellerFlowTest && NODE_ENV=page-prod npm run estimationFlowTest && NODE_ENV=page-prod npm run buyerFlowTest && NODE_ENV=page-prod npm run allTests",
    "eject": "react-scripts eject",
    "ncu": "ncu -x 'mini-css-extract-plugin eslint'",
    "ncu-u": "ncu -x 'mini-css-extract-plugin eslint' -u"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "jest": {
    "verbose": true,
    "transformIgnorePatterns": [
      "<roodDir>/node_modules/",
      "<roodDir>/__tests__/(?!config)"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/configJest/setupTests.js"
    ],
    "testTimeout": 30000,
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/configJest/assetsTransformer.js",
      "\\.(css|scss)$": "<rootDir>/configJest/styleMock.js"
    }
  },
  "devDependencies": {
    "@babel/node": "^7.15.8",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-es2015": "^7.0.0-beta.53",
    "@svgr/core": "^5.5.0",
    "@svgr/webpack": "^5.5.0",
    "@testing-library/react": "^12.1.2",
    "@testing-library/user-event": "^13.5.0",
    "autoprefixer": "^10.3.7",
    "axios": "^0.23.0",
    "babel-plugin-require-context-hook": "^1.0.0",
    "babel-plugin-transform-es2015-modules-commonjs": "^6.26.2",
    "clean-webpack-plugin": "^4.0.0",
    "compression": "^1.7.4",
    "concurrently": "^6.3.0",
    "copy-webpack-plugin": "^9.0.1",
    "css-loader": "^6.4.0",
    "cssnano": "^5.0.8",
    "eslint": "^7.32.0",
    "eslint-plugin-flowtype": "^6.1.1",
    "eslint-plugin-react-hooks": "^4.2.0",
    "eslint-webpack-plugin": "^3.0.1",
    "extract-css-chunks-webpack-plugin": "^4.9.0",
    "glob-all": "^3.2.1",
    "history": "^5.0.1",
    "html-critical-webpack-plugin": "^2.1.0",
    "html-webpack-plugin": "^5.5.0",
    "ignore-loader": "^0.1.2",
    "jest": "^27.3.1",
    "jest-environment-jsdom": "^27.3.1",
    "json-loader": "^0.5.7",
    "mini-css-extract-plugin": "2.4.3",
    "node-sass": "6.0.1",
    "open": "^8.4.0",
    "optimize-css-assets-webpack-plugin": "^6.0.1",
    "postcss": "^8.3.11",
    "postcss-loader": "^6.2.0",
    "postcss-split-css": "^1.0.2",
    "purgecss-webpack-plugin": "^4.0.3",
    "react-dev-utils": "^11.0.4",
    "react-stickyfill": "^0.2.5",
    "redux-mock-store": "^1.5.4",
    "regenerator-runtime": "^0.13.9",
    "reload": "^3.2.0",
    "resolve-url-loader": "^4.0.0",
    "sass-loader": "^12.2.0",
    "svg-inline-loader": "^0.8.2",
    "webpack": "5.59.1",
    "webpack-cli": "^4.9.1",
    "webpack-dev-server": "^4.3.1",
    "webpack-merge": "^5.8.0",
    "webpack-node-externals": "^3.0.0"
  }
}
