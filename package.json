  "scripts": {
    "start-fast": "NODE_ENV=page-dev webpack serve --no-client-overlay --config webpack.config.js --progress profile --env TEST --mode development",
    "start-dev": "NODE_ENV=page-dev webpack serve --no-client-overlay --config webpack.config.js --progress profile --env DEV_LOCAL --mode development",
    "start-prod": "NODE_ENV=page-dev webpack serve --no-client-overlay --config webpack.config.js --progress profile --env DEV --mode production",
    "build": "npm run lint && turbo run build:turbo",
    "build:turbo": "NODE_ENV=page-dev webpack --config webpack.config.js --progress --env DEV --mode production",
    "build-dev": "NODE_ENV=page-dev webpack --config webpack.config.js --progress --env DEV --mode production",
    "build-stage": "NODE_ENV=page-stage webpack --config webpack.config.js --progress --env STAGING --mode production",
    "build-prod": "NODE_ENV=page-prod webpack --config webpack.config.js --progress --env PROD --mode production",
    "install-styleguide": "rm -rf node_modules/@brixel && rm -rf package-lock.json && npm install",
    "start-updated": "rm -rf node_modules/@brixel && rm -rf package-lock.json && npm install && npx kill-port 5000 && NODE_ENV=page-dev webpack serve --no-client-overlay --config webpack.config.js --progress profile --env DEV_LOCAL --mode development",
    "eject": "react-scripts eject",
    "lint": "turbo run lint:turbo",
    "lint:turbo": "eslint --fix --config .eslintrc --ignore-path .eslintignore .",
    "ncu-u": "ncu -x '' -u",
    "e2e": "npx cypress run --e2e --headless --browser chrome",
    "test-cypress": "npm run start-test & npm run e2e",
    "test-component": "cypress open --component",
    "test-e2e": "npm run start-fast & cypress open --e2e --env flags='{\"feature-a\":true,\"feature-b\":false}'",
    "start-test": "node server.js"
  },
